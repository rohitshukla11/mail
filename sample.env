# =============================================================================
# dMail Configuration File Template
# =============================================================================
# INSTRUCTIONS:
# 1. Copy this file to the root directory: cp docs/sample.env .env
# 2. Fill in your actual values (replace placeholders starting with "your_")
# 3. NEVER commit .env to git (it should be in .gitignore)
# =============================================================================

# -----------------------------------------------------------------------------
# Filecoin Onchain Cloud / Synapse Configuration (Calibration Testnet)
# -----------------------------------------------------------------------------
# Choose ONE authentication path:
# 1. Wallet private key (recommended for local dev + server-side scripts)
FILECOIN_PRIVATE_KEY=0x_your_filecoin_private_key_here
# 2. Session key auth (cold wallet + delegated session key)
FILECOIN_WALLET_ADDRESS=0x_your_filecoin_wallet_address_here
FILECOIN_SESSION_KEY=0x_your_session_key_here

# Core network configuration
FILECOIN_RPC_URL=https://api.calibration.node.glif.io/rpc/v1
FILECOIN_WARM_STORAGE_ADDRESS=

# Optional dataset/provider hints
FILECOIN_DATASET_ID=
FILECOIN_DATASET_CREATE_NEW=false
FILECOIN_DATASET_OWNER=
FILECOIN_DATASET_NAMESPACE=
FILECOIN_PROVIDER_ID=
FILECOIN_PROVIDER_ADDRESS=
FILECOIN_AUTO_CONFIGURE_ALLOWANCES=true

# -----------------------------------------------------------------------------
# Ethereum / ENS Configuration (Sepolia Testnet)
# -----------------------------------------------------------------------------
# Your wallet's private key (used for ENS updates and CLI operations)
# This should be the private key that controls your ENS name
ETH_PRIVATE_KEY=0x_your_wallet_private_key_here

# Sepolia RPC endpoint (for ENS resolution and transactions)
# This is REQUIRED for ENS resolution since ENS names are on Sepolia testnet
# Using PublicNode (free, no API key required)
ETH_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Alternative Sepolia RPC endpoints (choose one):
# ETH_RPC_URL=https://sepolia.gateway.tenderly.co
# ETH_RPC_URL=https://rpc.ankr.com/eth_sepolia  # Requires API key: https://www.ankr.com/rpc/
# ETH_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY

# Default ENS name for CLI scripts (optional)
DMAIL_FROM_ENS=yourname.eth

# Optional: Recipient public key (fallback if ENS lookup fails)
# RECIPIENT_PUBLIC_KEY=0x04_your_recipient_public_key_here

# -----------------------------------------------------------------------------
# Frontend Configuration (Vite - must be prefixed with VITE_)
# -----------------------------------------------------------------------------
# These variables are exposed to the frontend React app
# IMPORTANT: Frontend uses Sepolia RPC for ENS resolution
# Using PublicNode (free, no API key required)
VITE_ETH_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Alternative: VITE_SEPOLIA_RPC_URL=https://sepolia.gateway.tenderly.co

# Filecoin configuration for frontend (Synapse SDK)
# Choose ONE authentication method (same as backend):
# Option 1: Private key (recommended for local dev)
VITE_FILECOIN_PRIVATE_KEY=0x_your_filecoin_private_key_here
# Option 2: Session key (for delegated access)
# VITE_FILECOIN_WALLET_ADDRESS=0x_your_filecoin_wallet_address_here
# VITE_FILECOIN_SESSION_KEY=0x_your_session_key_here

VITE_FILECOIN_RPC_URL=https://api.calibration.node.glif.io/rpc/v1
VITE_FILECOIN_WARM_STORAGE_ADDRESS=
VITE_FILECOIN_DATASET_ID=
VITE_FILECOIN_DATASET_CREATE_NEW=false

# Optional: Test private key for decryption in frontend (for demo/testing only)
# This is used to decrypt emails in the UI
# VITE_TEST_PRIVATE_KEY=0x_your_wallet_private_key_here
# VITE_WALLET_PRIVATE_KEY=0x_your_wallet_private_key_here

# Optional: Recipient public key fallback for frontend
# VITE_RECIPIENT_PUBLIC_KEY=0x04_your_recipient_public_key_here

# -----------------------------------------------------------------------------
# Setup Instructions
# -----------------------------------------------------------------------------
# See docs/COMPLETE_SETUP_GUIDE.md for detailed step-by-step instructions
